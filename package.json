{
  "name": "n8n-nodes-saturation",
  "version": "1.0.2",
  "description": "n8n community node for the Saturation API (/v1) \u2014 production-finance data: transactions, budgets, purchase orders, documents and the Library.",
  "keywords": [
    "n8n-community-node-package",
    "saturation",
    "production-finance",
    "budgeting"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Saturation-IO/n8n-nodes-saturation#readme",
  "author": {
    "name": "Saturation.io, Inc.",
    "email": "hello@saturation.io",
    "url": "https://saturation.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saturation-IO/n8n-nodes-saturation.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build && npm run lint",
    "scan": "npx @n8n/scan-community-package n8n-nodes-saturation"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SaturationApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Saturation/Saturation.node.js",
      "dist/nodes/SaturationTrigger/SaturationTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/Saturation-IO/n8n-nodes-saturation/issues"
  }
}
